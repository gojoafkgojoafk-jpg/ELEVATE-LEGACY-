
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Elevate Legacy | Fitness Store</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: #080b10;
  color: white;
  font-family: Arial, sans-serif;
}

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22px 7%;
  border-bottom: 1px solid #202b38;
}

.logo {
  font-size: 23px;
  font-weight: 900;
  letter-spacing: 2px;
}

.logo span {
  color: #70dfff;
}

nav a {
  color: #ccc;
  text-decoration: none;
  margin-left: 22px;
  font-size: 14px;
}

nav a:hover {
  color: #70dfff;
}

.cart {
  background: #70dfff;
  color: #080b10;
  padding: 10px 17px;
  border-radius: 7px;
  font-weight: bold;
  cursor: pointer;
}

.hero {
  min-height: 490px;
  padding: 100px 8%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background:
    radial-gradient(ellipse at 80% 40%,
    #14364a 0%, #101b29 30%, #080b10 72%);
}

.hero h1 {
  font-size: clamp(42px, 8vw, 76px);
  line-height: 1.05;
  max-width: 750px;
  font-weight: 900;
}

.hero h1 span {
  color: #70dfff;
}

.hero p {
  color: #aebdca;
  margin: 22px 0;
  line-height: 1.7;
  max-width: 460px;
}

.btn {
  display: inline-block;
  width: fit-content;
  background: #70dfff;
  color: #080b10;
  text-decoration: none;
  padding: 15px 26px;
  border-radius: 5px;
  font-weight: bold;
  border: none;
  cursor: pointer;
}

.section {
  padding: 65px 7%;
}

.section h2 {
  font-size: 30px;
  margin-bottom: 10px;
}

.subtitle {
  color: #91a1b0;
  margin-bottom: 30px;
}

.categories, .products {
  display: grid;
  grid-template-columns:
    repeat(auto-fit, minmax(210px, 1fr));
  gap: 20px;
}

.category {
  background: #111a25;
  padding: 35px 20px;
  border: 1px solid #24394b;
  border-radius: 10px;
  text-align: center;
}

.category .symbol {
  font-size: 38px;
  margin-bottom: 15px;
}

.category h3 {
  color: #70dfff;
}

.product {
  background: #111a25;
  border: 1px solid #26394a;
  border-radius: 10px;
  overflow: hidden;
}

.product img {
  width: 100%;
  height: 210px;
  object-fit: cover;
  background: #182330;
}

.product-info {
  padding: 20px;
}

.product-info p {
  color: #9babb9;
  margin: 10px 0;
}

.price {
  color: #70dfff;
  font-size: 21px;
  font-weight: bold;
  margin: 15px 0;
}

.add {
  width: 100%;
  padding: 12px;
  border: none;
  background: #70dfff;
  color: #080b10;
  font-weight: bold;
  border-radius: 5px;
  cursor: pointer;
}

footer {
  padding: 35px;
  text-align: center;
  color: #8997a5;
  border-top: 1px solid #24313d;
}

@media(max-width: 650px) {
  header {
    padding: 18px 5%;
    flex-wrap: wrap;
    gap: 15px;
  }

  nav {
    order: 3;
    width: 100%;
    display: flex;
    justify-content: space-between;
  }

  nav a {
    margin: 0;
    font-size: 12px;
  }

  .hero {
    padding: 75px 6%;
  }

  .section {
    padding: 45px 5%;
  }
}
</style>
</head>

<body>

<header>
  <div class="logo">ELEVATE <span>LEGACY.</span></div>

  <nav>
    <a href="#home">Home</a>
    <a href="#categories">Categories</a>
    <a href="#products">Products</a>
  </nav>

  <button class="cart" onclick="showCart()">
    CART (<span id="count">0</span>)
  </button>
</header>

<main>
<section class="hero" id="home">
  <h1>BUILD YOUR<br><span>LEGACY.</span></h1>
  <p>
    Your fitness journey deserves better.
    Explore sports nutrition and gym essentials
    at Elevate Legacy.
  </p>
  <a href="#products" class="btn">EXPLORE PRODUCTS →</a>
</section>

<section class="section" id="categories">
  <h2>SHOP BY CATEGORY</h2>
  <p class="subtitle">Everything for your fitness journey.</p>

  <div class="categories">
    <div class="category">
      <div class="symbol">🥤</div>
      <h3>Protein & Nutrition</h3>
      <p>Explore nutrition products.</p>
    </div>

    <div class="category">
      <div class="symbol">🏋️</div>
      <h3>Gym Equipment</h3>
      <p>Explore training essentials.</p>
    </div>

    <div class="category">
      <div class="symbol">💪</div>
      <h3>Accessories</h3>
      <p>Gear up for your workouts.</p>
    </div>
  </div>
</section>

<section class="section" id="products">
  <h2>FEATURED PRODUCTS</h2>
  <p class="subtitle">Discover our sample collection.</p>

  <div class="products">

    <div class="product">
      <img src="https://placehold.co/500x400/172535/70dfff?text=Whey+Protein"
      alt="Whey protein sample">
      <div class="product-info">
        <h3>Whey Protein</h3>
        <p>Sample nutrition product</p>
        <div class="price">₹1,999</div>
        <button class="add" onclick="addToCart('Whey Protein',1999)">
          ADD TO CART
        </button>
      </div>
    </div>

    <div class="product">
      <img src="https://placehold.co/500x400/172535/70dfff?text=Dumbbells"
      alt="Dumbbells">
      <div class="product-info">
        <h3>Dumbbell Set</h3>
        <p>Sample gym equipment</p>
        <div class="price">₹999</div>
        <button class="add" onclick="addToCart('Dumbbell Set',999)">
          ADD TO CART
        </button>
      </div>
    </div>

    <div class="product">
      <img src="https://placehold.co/500x400/172535/70dfff?text=Resistance+Bands"
      alt="Resistance bands">
      <div class="product-info">
        <h3>Resistance Bands</h3>
        <p>Sample training accessory</p>
        <div class="price">₹499</div>
        <button class="add" onclick="addToCart('Resistance Bands',499)">
          ADD TO CART
        </button>
      </div>
    </div>

  </div>
</section>
</main>

<footer>
  <h3>ELEVATE LEGACY.</h3>
  <p>FUEL YOUR AMBITION. BUILD YOUR LEGACY.</p>
  <p>© 2026 Elevate Legacy. Demo store.</p>
</footer>

<script>
let cart = [];

function addToCart(name, price) {
  cart.push({name, price});
  document.getElementById("count").textContent =
    cart.length;
  alert(name + " added to your cart!");
}

function showCart() {
  if (cart.length === 0) {
    alert("Your cart is empty!");
    return;
  }

  let total = cart.reduce((sum, item) =>
    sum + item.price, 0);

  let items = cart.map(item =>
    item.name + " - ₹" + item.price
  ).join("\n");

  alert(items + "\n\nTotal: ₹" + total);
}
</script>

</body>
</html>
